

/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #080b18;
    color: white;
    line-height: 1.6;
}

/* Navigation Bar */
header {
    background: #10152a;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
}

.logo {
    font-size: 28px;
    color: white;
}

.logo span,
.section-title span {
    color: #a855f7;
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

.navbar a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

.navbar a:hover {
    color: #a855f7;
}

/* Hero Section */
.hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 70px 10%;
    gap: 40px;
    background: radial-gradient(circle at 80% 40%, #29205a, #080b18 60%);
}

.hero-content {
    max-width: 600px;
}

.welcome {
    color: #a855f7;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 55px;
    margin-bottom: 10px;
}

.hero h1 span {
    color: #a855f7;
}

.hero h2 {
    font-size: 27px;
    margin-bottom: 20px;
}

.hero-content>p:not(.welcome) {
    color: #c2c6d5;
    margin-bottom: 25px;
}

.buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 12px 25px;
    background: #9333ea;
    color: white;
    border: 2px solid #9333ea;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: 0.3s;
    font-size: 15px;
}

.btn:hover {
    background: #7e22ce;
    transform: translateY(-4px);
}

.btn.outline {
    background: transparent;
}

.btn.outline:hover {
    background: #9333ea;
}

.hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.profile-circle {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 100px;
    font-weight: bold;
    background: linear-gradient(135deg, #9333ea, #2563eb);
    box-shadow: 0 0 60px #9333ea66;
    border: 5px solid #c084fc;
}

/* Common Sections */
.section {
    padding: 80px 10%;
}

.section-title {
    text-align: center;
    font-size: 36px;
    margin-bottom: 45px;
}

/* About Section */
.about-card {
    background: #151b32;
    padding: 35px;
    border-radius: 15px;
    border-left: 4px solid #a855f7;
    margin-bottom: 30px;
}

.about-card h3 {
    color: #c084fc;
    margin-bottom: 15px;
}

.about-card p {
    color: #c2c6d5;
}

.about-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.info-card {
    background: #151b32;
    padding: 25px;
    text-align: center;
    border-radius: 12px;
    transition: 0.3s;
}

.info-card:hover {
    transform: translateY(-8px);
    background: #222b4a;
}

.info-card h3 {
    color: #a855f7;
    margin-bottom: 12px;
}

/* Skills Section */
.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background: #151b32;
    padding: 30px;
    border-radius: 12px;
    border-bottom: 3px solid #9333ea;
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 30px #9333ea33;
}

.skill-card h3 {
    color: #c084fc;
    margin-bottom: 10px;
}

.skill-card p {
    color: #c2c6d5;
}

/* Projects Section */
.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    background: linear-gradient(145deg, #171d38, #10152a);
    padding: 30px;
    border-radius: 15px;
    border: 1px solid #343b60;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-10px);
    border-color: #a855f7;
}

.project-number {
    font-size: 35px;
    color: #a855f7;
    font-weight: bold;
    margin-bottom: 15px;
}

.project-card h3 {
    margin-bottom: 12px;
}

.project-card p {
    color: #c2c6d5;
    margin-bottom: 20px;
}

.project-card span {
    display: inline-block;
    background: #30204f;
    color: #d8b4fe;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 13px;
    margin-right: 5px;
}

/* Learning Journey */
.journey-card {
    max-width: 750px;
    margin: 20px auto;
    padding: 25px;
    background: #151b32;
    border-left: 4px solid #a855f7;
    border-radius: 10px;
    transition: 0.3s;
}

.journey-card:hover {
    transform: translateX(8px);
}

.journey-card h3 {
    color: #c084fc;
    margin-bottom: 8px;
}

/* Contact Section */
.contact-text {
    text-align: center;
    color: #c2c6d5;
    margin-bottom: 25px;
}

.contact-card {
    max-width: 600px;
    margin: auto;
    background: #151b32;
    padding: 35px;
    border-radius: 15px;
}

.contact-card form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
}

.contact-card input,
.contact-card textarea {
    width: 100%;
    padding: 14px;
    background: #080b18;
    border: 1px solid #343b60;
    border-radius: 8px;
    color: white;
    font-size: 15px;
    font-family: inherit;
}

.contact-card textarea {
    resize: vertical;
}

.contact-card input:focus,
.contact-card textarea:focus {
    outline: 1px solid #a855f7;
}

.contact-card p {
    margin-top: 10px;
    color: #c2c6d5;
}

/* Footer */
footer {
    background: #10152a;
    padding: 25px;
    text-align: center;
    color: #c2c6d5;
}

footer a {
    display: inline-block;
    margin-top: 10px;
    color: #c084fc;
    text-decoration: none;
}

/* Responsive Design */
@media (max-width: 900px) {
    .hero {
        flex-direction: column-reverse;
        text-align: center;
    }

    .buttons {
        justify-content: center;
    }

    .skills-container,
    .projects-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .navbar ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero h2 {
        font-size: 21px;
    }

    .profile-circle {
        width: 200px;
        height: 200px;
        font-size: 75px;
    }

    .section {
        padding: 60px 6%;
    }

    .section-title {
        font-size: 30px;
    }

    .about-details,
    .skills-container,
    .projects-container {
        grid-template-columns: 1fr;
    }
}
